{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mygameengine",
  "version": "1.0.0",
  "dependencies": [
    "glfw3",
    "glm",
    "enkits",
    "tracy"
  ],
  "features": {
    "tracy-on-demand": {
      "description": "Tracy пишет только пока подключён профайлер (повседневная отладка)",
      "dependencies": [
        {
          "name": "tracy",
          "features": [ "on-demand" ]
        }
      ]
    }
  }
}